  "wind": {
    "comment": "Поле ветра (4.3). Направление в градусах: 0 — слева направо, плюс — к камере. Скорости м/с. Порыв: фронт шириной width м проходит сцену. Вихри дрейфуют с ветром и раз в boostEvery секунд (в среднем) усиливаются на 5 с.",
    "base": { "speed": [0.3, 1.5], "direction": 0, "spread": 20, "period": [20, 40] },
    "gust": { "speed": [2.0, 4.0], "duration": [2, 4], "interval": [8, 25], "width": 10 },
    "vortices": { "count": 2, "radius": [2.5, 5], "strength": [0.6, 1.8], "boostEvery": 150 },
    "turbulence": { "scale": 0.35, "speed": 0.25, "strength": 0.9 },
    "updraft": 0.35
  },

