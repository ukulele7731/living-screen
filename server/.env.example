# «Живой экран» — сервер. Скопировать в .env. Значения по умолчанию рассчитаны на
# docker compose из этой папки (два контейнера: app и caddy). Без Docker — тоже работают.

# ── Приложение ──
NODE_ENV=development
# Порт, который слушает Node (внутри контейнера; наружу его отдаёт Caddy)
PORT=3000
HOST=0.0.0.0
# Уровень логов: trace | debug | info | warn | error
LOG_LEVEL=info
# Публичный адрес сайта — подставляется в QR и ссылки. Локально — адрес Caddy.
PUBLIC_URL=http://localhost:8080
# Сезон новых комнат: autumn | winter
DEFAULT_SEASON=autumn

# ── Данные: база SQLite и картинки листьев ──
# Папка с базой (db.sqlite) и картинками (rooms/{код}/leaves/...). В compose это ./data
# рядом с файлом compose — обычная папка, чтобы бэкапить архивом.
DATA_DIR=data
# Ниже этого свободного места на диске /healthz отвечает 503 (МБ)
MIN_FREE_MB=500

# ── Caddy ──
# Адрес, который обслуживает Caddy. Локально «:80» (снаружи порт 8080, см. compose).
# На VPS — домен, HTTPS Caddy получит сам. Кириллический домен — в punycode:
# SITE_ADDRESS=xn----8sbepkhizex5l.xn--p1ai  (это живой-экран.рф)
SITE_ADDRESS=:80
# Порты Caddy снаружи: локально 8080/8443, на VPS 80/443
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443

# ── Telegram-бот (шаг 3.4; пока пусто — бот не запускается) ──
TELEGRAM_BOT_TOKEN=

# ── Бэкапы (шаг 3.6; ключи объектного хранилища нужны только скрипту ops/backup.sh) ──
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
