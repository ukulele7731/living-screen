# «Живой экран» — сервер. Скопировать в .env и заполнить. Все значения по умолчанию
# рассчитаны на docker compose из этой папки: сервисы postgres, redis, minio, app, caddy.

# ── Приложение ──
NODE_ENV=development
# Порт, который слушает Node внутри контейнера (наружу его отдаёт Caddy)
PORT=3000
HOST=0.0.0.0
# Уровень логов: trace | debug | info | warn | error
LOG_LEVEL=info
# Публичный адрес сайта — подставляется в QR и ссылки. Локально — адрес Caddy.
PUBLIC_URL=http://localhost:8080

# ── Caddy ──
# Адрес, который обслуживает Caddy. Локально «:80» (порт 8080 снаружи, см. compose).
# На VPS — домен: SITE_ADDRESS=zhivoy-ekran.ru — HTTPS Caddy получит сам.
SITE_ADDRESS=:80

# ── PostgreSQL ──
POSTGRES_USER=living
POSTGRES_PASSWORD=living-dev-password
POSTGRES_DB=living
# Строка подключения для приложения (внутри compose хост — «postgres»)
DATABASE_URL=postgres://living:living-dev-password@postgres:5432/living

# ── Redis (коды привязки, лимиты — всё, что можно потерять) ──
REDIS_URL=redis://redis:6379

# ── Объектное хранилище S3 (локально — MinIO из compose; на VPS — Timeweb/Selectel) ──
S3_ENDPOINT=http://minio:9000
S3_REGION=ru-1
S3_BUCKET=living-screen
S3_ACCESS_KEY=living
S3_SECRET_KEY=living-dev-secret
# true для MinIO и большинства российских S3 (адрес вида endpoint/bucket, а не bucket.endpoint)
S3_FORCE_PATH_STYLE=true
# Логин/пароль консоли MinIO (только локально)
MINIO_ROOT_USER=living
MINIO_ROOT_PASSWORD=living-dev-secret

# ── Telegram-бот (шаг 3.4; пока пусто — бот не запускается) ──
TELEGRAM_BOT_TOKEN=
