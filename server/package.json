{
  "name": "living-screen-server",
  "version": "0.1.0",
  "private": true,
  "description": "«Живой экран» — сервер: комнаты, роли, листья, WebSocket, Telegram-бот (server-spec.md). Один процесс: Node + SQLite + папка data/",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "grammy": "^1.46.0",
    "sharp": "^0.35.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.3",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  }
}
