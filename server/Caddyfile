# Caddy: HTTPS сам (на домене), API и WebSocket — в Node, статика сцены и загрузчика — из /srv/www.
{$SITE_ADDRESS} {
	encode gzip

	@app path /api/* /ws/* /healthz
	reverse_proxy @app app:3000

	# Статика сцены и загрузчика (собранный dist сцены кладётся в ./www рядом с compose; шаг 3.7)
	root * /srv/www
	file_server
}
